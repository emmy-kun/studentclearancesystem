{
  "name": "clearance-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:reset": "node src/db/migrate.js --reset",
    "db:seed": "node src/db/seed.js",
    "test": "node --test --test-concurrency=1",
    "import:students": "node src/db/importStudents.js",
    "demo": "node scripts/demoData.js",
